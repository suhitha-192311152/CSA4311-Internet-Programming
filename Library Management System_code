<!DOCTYPE html> 

<html> 

<head> 

<title>Library Management System</title> 

<style> 

body { font-family: Arial; margin: 30px; background: #f2f6fc; } 

h1 { color: navy; } 

input, button { padding: 8px; margin: 5px; } 

table { border-collapse: collapse; margin-top: 15px; background: white; } 

th, td { border: 1px solid black; padding: 10px; } 

th { background: lightblue; } 

</style> 

</head> 

<body> 

<h1>Library Management System</h1> 

<h2>Search Books</h2> 

<input id="book" placeholder="Enter book title"> 

<button onclick="searchBook()">Search</button> 

<p id="result"></p> 

<table> 

<tr><th>Book ID</th><th>Book Name</th><th>Author</th><th>Status</th></tr> 

<tr><td>101</td><td>Java Programming</td><td>James Gosling</td><td>Available</td></tr> 

<tr><td>102</td><td>Web Technology</td><td>Tim Berners-Lee</td><td>Available</td></tr> 

<tr><td>103</td><td>Python Basics</td><td>Guido van Rossum</td><td>Available</td></tr> 

</table> 

<script> 

function searchBook() { 

  let name = document.getElementById("book").value.toLowerCase(); 

  let books = ["java programming", "web technology", "python basics"]; 

  if (books.includes(name)) { 

    document.getElementById("result").innerHTML = name + " book is available."; 

  } else { 

    document.getElementById("result").innerHTML = "Book not found."; 

  } 

} 

</script> 

</body> 

</html> 
